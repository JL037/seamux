#!/usr/bin/env node
// The fake `claude` command, first on PATH in the tests (test/setup.ts), so no
// test reads the real Claude Code's sessions. `claude agents --json` lists
// none; anything else is refused.
const args = process.argv.slice(2);
if (args[0] === "agents" && args.includes("--json")) {
  process.stdout.write("[]\n");
  process.exit(0);
}
process.stderr.write(`fake claude: unsupported command: ${args.join(" ")}\n`);
process.exit(2);
