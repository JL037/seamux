#!/bin/sh
# seamux's command line. With no command it runs the board (supervise),
# setting seamux up first if it isn't; `setup` and `uninstall` add or remove
# the subagent hooks and the dispatch skill (setup); anything else goes to
# the protocol CLI (seamux).
#
# A git checkout runs the TypeScript under scripts/ and hooks/. An installed
# package runs the bundled JavaScript in dist/, since Node won't strip types
# under node_modules.
# npm links this file into node_modules/.bin, so resolve the link to find the package.
repo="$(cd "$(dirname "$(realpath "$0")")/.." && pwd)"

# The script for an entry: script <name>
script() {
  if [ -e "$repo/.git" ]; then echo "$repo/scripts/$1.ts"; else echo "$repo/dist/$1.js"; fi
}

case "$1" in
  "") exec node --no-warnings "$(script supervise)" ;;
  setup|uninstall) exec node --no-warnings "$(script setup)" "$1" ;;
  *) exec node --no-warnings "$(script seamux)" "$@" ;;
esac
