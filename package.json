{
  "name": "seemux",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "npm install && npm run hooks:install && npm run skills:install",
    "serve": "node --no-warnings scripts/supervise.ts",
    "dev": "react-router dev",
    "land": "node --no-warnings scripts/land.ts",
    "board": "npm run build && HOST=127.0.0.1 PORT=4173 NODE_NO_WARNINGS=1 react-router-serve ./build/server/index.js",
    "build": "react-router build",
    "start": "HOST=127.0.0.1 react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "hooks:install": "node --no-warnings scripts/install-hooks.ts",
    "hooks:uninstall": "node --no-warnings scripts/install-hooks.ts --uninstall",
    "skills:install": "node --no-warnings scripts/install-skills.ts",
    "skills:uninstall": "node --no-warnings scripts/install-skills.ts --uninstall"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@react-router/node": "^7.18.4",
    "@react-router/serve": "^7.18.4",
    "@tailwindcss/typography": "^0.5.20",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "isbot": "^5.1.36",
    "lucide-react": "^1.47.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@react-router/dev": "^7.18.4",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3"
  }
}
